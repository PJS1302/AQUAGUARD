# ==============================================================================
# AQUAGUARD CONFIGURATION & API KEYS GUIDE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. POSTGRESQL DATABASE (Primary Persistence)
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://aquaguard:AquaGuard%402026@localhost:5432/aquaguard"

# ------------------------------------------------------------------------------
# 2. LOCAL ML & SHAP EXPLAINABLE AI
# ------------------------------------------------------------------------------
# NOTE: SHAP (TreeExplainer/LinearExplainer) and AquaGuard's Water Potability ML
# classifiers run 100% LOCALLY and OFFLINE via scikit-learn and shap in Python.
# No paid external API key is required for ML predictions or SHAP explanations!
AQUAGUARD_MODEL_DIR=backend/models
AQUAGUARD_UPLOAD_DIR=backend/data/uploads
AQUAGUARD_MAX_UPLOAD_MB=25
AQUAGUARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# ------------------------------------------------------------------------------
# 3. OPTIONAL GENERATIVE AI ADVISORY (Gemini or OpenAI)
# ------------------------------------------------------------------------------
# If you want natural language chemical advisories and treatment recommendations
# generated on top of your SHAP values, provide either a Gemini or OpenAI key:
#
# Get Google Gemini key at: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"
#
# Get OpenAI key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY="sk-proj-YourOpenAiKeyHere"

# ------------------------------------------------------------------------------
# 4. OPTIONAL HARDWARE & SENSOR API KEY (ESP32 / IoT Devices)
# ------------------------------------------------------------------------------
# If set, external devices pushing sensor telemetry to /api/devices/{id}/readings
# must supply the HTTP header: "X-API-Key: your_custom_secret_key"
# AQUAGUARD_API_KEY="your-optional-device-secret-key"
